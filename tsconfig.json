{
  // Type-checking only: Gatsby compiles .ts/.tsx itself (Babel), so `npm run typecheck` (and
  // `npm run build`, which runs it first) are what enforce these types.
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "es2020"],
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "gatsby-*.ts", "gatsby-*.tsx"]
}
