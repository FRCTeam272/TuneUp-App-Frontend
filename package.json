{
  "name": "fll-scoreboard",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/free-regular-svg-icons": "^6.2.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "bootstrap": "^5.2.2",
    "dotenv": "^17.2.3",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.3.2",
    "gatsby": "^5.12.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-styled-components": "^6.12.0",
    "http-proxy-middleware": "^2.0.6",
    "react": "^18.2.0",
    "react-bootstrap": "^2.5.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.0",
    "styled-components": "^5.3.6",
    "use-sound": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "cross-env": "^10.1.0",
    "nswag": "^14.7.1"
  },
  "scripts": {
    "develop": "cross-env NODE_ENV=development gatsby develop",
    "develop:ssr": "cross-env NODE_ENV=development GATSBY_DEV_SSR=true gatsby develop",
    "start": "cross-env NODE_ENV=development gatsby develop",
    "build": "gatsby clean && cross-env NODE_ENV=production gatsby build",
    "build:dev": "cross-env NODE_ENV=development gatsby build",
    "build:ssr": "cross-env NODE_ENV=production gatsby build && gatsby serve",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "jest",
    "api:spec": "node scripts/update-api-spec.js",
    "api:generate": "nswag run nswag.json /runtime:Net80",
    "api:update": "npm run api:spec && npm run api:generate"
  },
  "allowScripts": {
    "@fortawesome/fontawesome-common-types@6.2.0": true,
    "@fortawesome/fontawesome-svg-core@6.2.0": true,
    "@fortawesome/free-regular-svg-icons@6.2.0": true,
    "lmdb@2.5.2": true,
    "lmdb@2.5.3": true,
    "@parcel/watcher@2.5.1": true,
    "core-js@3.46.0": true,
    "core-js-pure@3.26.0": true,
    "es5-ext@0.10.64": true,
    "gatsby@5.15.0": true,
    "gatsby-cli@5.15.0": true,
    "msgpackr-extract@3.0.3": true,
    "sharp@0.32.6": true,
    "styled-components@5.3.6": true
  }
