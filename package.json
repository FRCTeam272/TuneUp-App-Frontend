    "@fortawesome/react-fontawesome": "^3.5.0",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.9",
    "font-awesome": "^4.7.0",
    "fs-extra": "^11.4.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-manifest": "^5.16.0",
    "http-proxy-middleware": "^3.0.10",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "cross-env": "^10.1.0",
    "nswag": "^14.7.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "develop": "cross-env NODE_ENV=development gatsby develop",
    "develop:ssr": "cross-env NODE_ENV=development GATSBY_DEV_SSR=true gatsby develop",
    "start": "cross-env NODE_ENV=development gatsby develop",
    "build": "gatsby clean && tsc --noEmit && cross-env NODE_ENV=production gatsby build",
    "build:dev": "cross-env NODE_ENV=development gatsby build",
    "build:ssr": "cross-env NODE_ENV=production gatsby build && gatsby serve",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "jest",
    "api:spec": "node scripts/update-api-spec.js",
    "api:generate": "nswag run nswag.json /runtime:Net80",
    "api:update": "npm run api:spec && npm run api:generate",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "@fortawesome/fontawesome-common-types@6.2.0": true,
    "@fortawesome/fontawesome-svg-core@6.2.0": true,
    "@fortawesome/free-regular-svg-icons@6.2.0": true,
    "lmdb@2.5.2": true,
    "lmdb@2.5.3": true,
    "@parcel/watcher@2.5.1": true,
